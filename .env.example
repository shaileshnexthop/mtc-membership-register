# Copy to .env for local development. On the server, /opt/mtc/.env is
# created by deploy/bootstrap.sh. Never commit real values.

SITE_DOMAIN=localhost
APP_BASE_URL=http://localhost:3000

DATABASE_URL=postgres://mtc:mtc@localhost:5432/mtc
SESSION_SECRET=change-me-to-64-random-hex-characters

# Staff sign-in: app registration in MTC's Microsoft 365 tenant
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Email through SMTP2GO (HTTPS API). Leave the key empty locally to log emails to the console.
SMTP2GO_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=The Mauritius Turf Club

# Document storage: private Lightsail bucket (S3-compatible)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# MIPS payment gateway
MIPS_MODE=test
MIPS_MERCHANT_ID=
MIPS_API_USERNAME=
MIPS_API_PASSWORD=
